# ── Environment ──────────────────────────────────────────────────────
# Copy to .env and fill in values. NEVER commit the real .env file.

# Port (Render sets this automatically)
PORT=3000

# ── Firebase Admin SDK ───────────────────────────────────────────────
# Option A: path to a service-account JSON file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: inline JSON string (Render environment variable)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase project ID
FIREBASE_PROJECT_ID=your-project-id

# ── Cloudinary (image storage) ───────────────────────────────────────
# Firebase Storage requires the Blaze plan even for free-tier usage, so all
# image uploads (profile pictures, event banners, memory-wall photos,
# project covers) go through Cloudinary instead — see POST /api/upload-image.
# Free account, no card required: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Gemini API ───────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins (Flutter web dev build; the Next.js app
# calls the backend server-to-server through its /api/backend proxy)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5000

# ── Rate Limiting ────────────────────────────────────────────────────
# Max Gemini API calls per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
