# ── Environment ──────────────────────────────────────────────────────
# Copy to .env and fill in values. NEVER commit the real .env file.

# Port (Render sets this automatically)
PORT=3000

# ── Firebase Admin SDK ───────────────────────────────────────────────
# Option A: path to a service-account JSON file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: inline JSON string (Render environment variable)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase project ID (used for Storage bucket)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ── Gemini API ───────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins (Flutter web dev build; the Next.js app
# calls the backend server-to-server through its /api/backend proxy)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5000

# ── Rate Limiting ────────────────────────────────────────────────────
# Max Gemini API calls per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
