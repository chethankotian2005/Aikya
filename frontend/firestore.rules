rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // HELPERS
    // Roles (spec §5): student | faculty | coordinator | hod.
    // The role is always read from the requester's own users/{uid} doc —
    // never from anything the client sends.
    // ═══════════════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return signedIn() && role() in roles;
    }

    function isStudent() {
      return hasRole(['student']);
    }

    function isHod() {
      return hasRole(['hod']);
    }

    function isStaff() {
      return hasRole(['faculty', 'coordinator', 'hod']);
    }

    /// Coordinators may only manage events they created.
    function isCreator(eventData) {
      return hasRole(['coordinator']) && eventData.createdBy == request.auth.uid;
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function registrationPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid);
    }

    /// Counter +1 is only valid in the same write that creates the caller's registration.
    function isJoining(eventId) {
      return signedIn()
        && onlyChanged(['currentRegistrations'])
        && request.resource.data.currentRegistrations == resource.data.currentRegistrations + 1
        && request.resource.data.currentRegistrations <= resource.data.maxCapacity
        && !exists(registrationPath(eventId))
        && existsAfter(registrationPath(eventId));
    }

    /// Counter -1 is only valid in the same write that deletes the caller's registration.
    function isLeaving(eventId) {
      return signedIn()
        && onlyChanged(['currentRegistrations'])
        && request.resource.data.currentRegistrations == resource.data.currentRegistrations - 1
        && exists(registrationPath(eventId))
        && !existsAfter(registrationPath(eventId));
    }

    // ═══════════════════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════════════════

    match /users/{uid} {
      allow read: if signedIn();

      // Self-signup is students only — staff are provisioned by the backend.
      // The Auth email must be the USN's derived address, so one USN = one account.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['email', 'usn', 'fullName', 'role'])
        && request.resource.data.role == 'student'
        && request.resource.data.usn.matches('^4MW[0-9]{2}AI[0-9]{3}$')
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email == request.resource.data.usn.lower() + '@aikya.smvitm.edu';

      // Owners edit their own profile but can never change role, email, USN,
      // club or faculty ID (USN/batch changes go through PUT /api/profile).
      allow update: if isHod()
        || (isOwner(uid)
            && unchanged('role')
            && unchanged('email')
            && unchanged('usn')
            && unchanged('club')
            && unchanged('facultyId'));

      allow delete: if isHod();
    }

    // ═══════════════════════════════════════════════════════════════════
    // EVENTS
    // ═══════════════════════════════════════════════════════════════════

    match /events/{eventId} {
      // Pending/rejected events (coordinator-created, awaiting HOD review)
      // are visible only to their creator and the HOD — everyone else only
      // sees approved events.
      allow read: if signedIn()
        && (resource.data.status == 'approved'
            || resource.data.createdBy == request.auth.uid
            || isHod());

      // Posted through POST /api/messaging/events so an HOD's event can be
      // auto-approved and a coordinator's event can notify the HOD, in the
      // same request (spec §2/§7 — avoids Cloud Functions).
      allow create: if false;

      // Coordinators may edit their own event freely as long as `status`
      // doesn't change (no self-approval) — except moving a rejected event
      // back to pending to resubmit it after fixing whatever was wrong.
      // Only the HOD (via POST /api/messaging/event/approve|reject) or an
      // HOD's own direct edit can otherwise change `status`.
      allow update: if (isHod() && unchanged('createdBy'))
        || (isCreator(resource.data) && unchanged('createdBy')
            && (unchanged('status')
                || (resource.data.status == 'rejected' && request.resource.data.status == 'pending')))
        || isJoining(eventId)
        || isLeaving(eventId);

      allow delete: if isHod() || isCreator(resource.data);

      // ─── REGISTRATIONS (doc ID = student uid) ────────────────────

      match /registrations/{studentUid} {
        allow read: if signedIn();

        // Only students register, and only together with the +1 counter update.
        allow create: if isOwner(studentUid)
          && isStudent()
          && request.resource.data.keys().hasAll(['formResponses', 'registeredAt'])
          && getAfter(eventPath(eventId)).data.currentRegistrations
               == get(eventPath(eventId)).data.currentRegistrations + 1;

        allow delete: if (isOwner(studentUid)
              && getAfter(eventPath(eventId)).data.currentRegistrations
                   == get(eventPath(eventId)).data.currentRegistrations - 1)
          || isHod()
          || isCreator(get(eventPath(eventId)).data);

        allow update: if false;
      }

      // ─── COMMENTS ────────────────────────────────────────────────

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'commentText', 'createdAt'])
          && !request.resource.data.keys().hasAny(['sentimentLabel', 'sentimentScore'])
          && request.resource.data.commentText is string
          && request.resource.data.commentText.size() > 0
          && request.resource.data.commentText.size() <= 1000;

        allow delete: if resource.data.userId == request.auth.uid
          || isHod()
          || isCreator(get(eventPath(eventId)).data);

        // Sentiment fields are written by the backend (Admin SDK) only.
        allow update: if false;
      }
    }

    // "My registrations" is a collection-group query on studentUid.
    match /{path=**}/registrations/{studentUid} {
      allow read: if signedIn();
    }

    // ═══════════════════════════════════════════════════════════════════
    // UPDATES (faculty "Post Update" feed)
    // ═══════════════════════════════════════════════════════════════════

    match /updates/{updateId} {
      allow read: if signedIn();

      // Posted through POST /api/messaging/updates so the push goes out in the same request.
      allow create, update: if false;

      allow delete: if isHod() || resource.data.authorId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════
    // PROJECTS
    // ═══════════════════════════════════════════════════════════════════

    match /projects/{projectId} {
      allow read: if signedIn();

      allow create: if isStudent()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'description', 'techStack', 'ownerUid'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.techStack is list;

      allow update: if (resource.data.ownerUid == request.auth.uid && unchanged('ownerUid'))
        || isHod();

      allow delete: if resource.data.ownerUid == request.auth.uid || isHod();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ATTENDANCE REQUESTS
    // ═══════════════════════════════════════════════════════════════════

    match /attendanceRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isHod());

      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
             'studentId', 'eventId', 'requestDetails', 'status'
           ]);

      // Approve/reject goes through the backend so it can notify the student.
      allow update: if false;

      allow delete: if isHod()
        || (resource.data.studentId == request.auth.uid && resource.data.status == 'pending');
    }

    // ═══════════════════════════════════════════════════════════════════
    // ALUMNI PROFILES
    // ═══════════════════════════════════════════════════════════════════

    match /alumniProfiles/{uid} {
      allow read: if signedIn();

      allow create: if (isOwner(uid) && request.resource.data.verifiedByHod == false)
        || isHod();

      allow update: if (isOwner(uid) && unchanged('verifiedByHod'))
        || isHod();

      allow delete: if isHod();
    }

    // ═══════════════════════════════════════════════════════════════════
    // MEMORY FRAMES (photo wall)
    // ═══════════════════════════════════════════════════════════════════

    match /memoryFrames/{frameId} {
      allow read: if signedIn()
        && (resource.data.status == 'approved'
            || resource.data.uploadedBy == request.auth.uid
            || isHod());

      allow create: if signedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.likesCount == 0;

      // Moderation goes through the backend; clients may only move likes by one.
      allow update: if signedIn()
        && resource.data.status == 'approved'
        && onlyChanged(['likesCount'])
        && (request.resource.data.likesCount == resource.data.likesCount + 1
            || request.resource.data.likesCount == resource.data.likesCount - 1);

      allow delete: if isHod()
        || (resource.data.uploadedBy == request.auth.uid && resource.data.status == 'pending');
    }

    // ═══════════════════════════════════════════════════════════════════
    // ACCREDITATION REPORTS (written by the backend compiler)
    // ═══════════════════════════════════════════════════════════════════

    match /accreditationReports/{reportId} {
      allow read: if isStaff();
      allow create, update: if false;
      allow delete: if isHod();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ACADEMIC BATCH CONFIG
    // ═══════════════════════════════════════════════════════════════════

    match /academicBatchConfig/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isHod();
    }
  }
}
